APP_NAME="eVaistine.lt"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081
# Production: must match the browser-facing origin (e.g. https://api.liachovskis.com).
# Wrong APP_URL breaks @vite() asset URLs (CORS to localhost) and cached HTML.

NEXTAUTH_SECRET=

# Socialite (real values still need to be supplied — see the app's Google/
# Facebook developer console). Redirect URIs default to /auth/{provider}/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=vaistines
DB_USERNAME=root
DB_PASSWORD=

DB_BACKUP_PATH=/var/www/backups
DB_BACKUP_RETENTION_DAYS=14

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=redis
QUEUE_RETRY_AFTER=7200
SESSION_DRIVER=redis
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@evaistine.lt
MAIL_FROM_NAME="eVaistine.lt"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Meilisearch indexing only runs in production; leave empty locally.
MEILISEARCH_HOST=
MEILISEARCH_KEY=

# Sail: its own project name and host ports, so this stack never replaces the
# superakcijos (nuolaidos) containers running on the default ports.
COMPOSE_PROJECT_NAME=vaistines
APP_PORT=8081
VITE_PORT=5175
FORWARD_DB_PORT=3307
FORWARD_REDIS_PORT=6380
FORWARD_MAILHOG_PORT=1026
FORWARD_MAILHOG_DASHBOARD_PORT=8026
