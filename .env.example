APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Production: must match the browser-facing origin (e.g. https://api.liachovskis.com).
# Wrong APP_URL breaks @vite() asset URLs (CORS to localhost) and cached HTML.

NEXTAUTH_SECRET=

# Socialite (real values still need to be supplied — see the app's Google/
# Facebook developer console). Redirect URIs default to /auth/{provider}/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=

# Same secret as the frontend's REVALIDATE_SECRET — lets ProcessStoreDiscountsJob
# trigger the frontend's /api/revalidate after processing, without a full deploy.
REVALIDATE_SECRET=
FRONTEND_REVALIDATE_URL=https://superakcijos.lt/api/revalidate

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

DB_BACKUP_PATH=/var/www/backups
DB_BACKUP_RETENTION_DAYS=14

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=redis
QUEUE_RETRY_AFTER=7200
SESSION_DRIVER=redis
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Sail: Meilisearch runs on the host — use host.docker.internal, not 127.0.0.1
MEILISEARCH_HOST=http://host.docker.internal:7700
MEILISEARCH_KEY=
