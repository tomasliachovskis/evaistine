# Production .env for evaistine.lt (/var/www/evaistine/.env on the server).
# The server is shared with superakcijos.lt: keep the Redis DBs, prefixes and
# Meilisearch index prefix below, or this app flushes/overwrites superakcijos'
# data. deploy.sh refuses to run without them. Details: docs/evaistine.md,
# "Sharing the server with superakcijos" and "Launch checklist".
APP_NAME="eVaistine.lt"
APP_ENV=production
# php artisan key:generate --show (once, never reuse superakcijos' key)
APP_KEY=
APP_DEBUG=false
APP_URL=https://evaistine.lt

# OAuth apps of eVaistine's own, with https://evaistine.lt/auth/{provider}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=

LOG_CHANNEL=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Own database and own MySQL user (not superakcijos' user)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vaistines
DB_USERNAME=evaistine
DB_PASSWORD=

DB_BACKUP_PATH=/var/www/backups/evaistine
DB_BACKUP_RETENTION_DAYS=14

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=redis
QUEUE_RETRY_AFTER=7200
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=evaistinelt_database_
CACHE_PREFIX=evaistinelt_cache
# superakcijos uses 0/1
REDIS_DB=2
REDIS_CACHE_DB=3

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@evaistine.lt
MAIL_FROM_NAME="eVaistine.lt"

# eVaistine's own keys, not superakcijos'
OPENAI_API_KEY=
GEMINI_API_KEY=

# Shared Meilisearch instance: a key limited to evaistine_* indexes
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=
MEILISEARCH_INDEX_PREFIX=evaistine_

# Served at /{key}.txt; any 32+ hex chars (openssl rand -hex 16)
INDEXNOW_KEY=

# GA4, printed only in production behind the cookie consent (Consent Mode)
GA_MEASUREMENT_ID=G-B62M2HNEWJ
