<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory suffix="Test.php">./tests/Feature</directory>
        </testsuite>
    </testsuites>
    <coverage processUncoveredFiles="true">
        <include>
            <directory suffix=".php">./app</directory>
        </include>
    </coverage>
    <php>
        <server name="APP_ENV" value="testing"/>
        <server name="BCRYPT_ROUNDS" value="4"/>
        <server name="CACHE_DRIVER" value="array"/>
        <!--
            Force tests onto the local Sail MySQL container's disposable
            `laravel_test` database — a dedicated database, never the same
            one as .env's main DB_DATABASE. RefreshDatabase drops and
            re-migrates the configured database on every run; without this
            override it silently falls back to the app's main .env DB_HOST,
            which points at a shared remote server, not a local/disposable
            one. Note: this server override only takes effect inside a
            PHPUnit process (`sail artisan test`). A plain shell
            `DB_DATABASE=x sail artisan ...` prefix does NOT reach the Sail
            container and will silently run against the real .env database
            instead. Never rely on that pattern for anything destructive;
            use `sail artisan test`, or an explicit database flag.
        -->
        <server name="DB_CONNECTION" value="mysql"/>
        <server name="DB_HOST" value="mysql"/>
        <server name="DB_PORT" value="3306"/>
        <server name="DB_DATABASE" value="laravel_test"/>
        <server name="MAIL_MAILER" value="array"/>
        <server name="QUEUE_CONNECTION" value="sync"/>
        <server name="SESSION_DRIVER" value="array"/>
        <server name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
